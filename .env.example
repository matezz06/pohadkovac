# Klíč z https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modely (lze změnit i v aplikaci v Nastavení)
GEMINI_TEXT_MODEL=gemini-3.5-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# 1 = testovací režim bez volání API (zástupné obrázky a vzorový příběh)
GEMINI_MOCK=0

# Složka pro data (pohádky, fotky, ilustrace) – ideálně v Google Drive, např. na Macu:
# DATA_DIR=/Users/matej/Library/CloudStorage/GoogleDrive-matezz06@gmail.com/Můj disk/AI-Projekty/10_Projekty/Pohadkovac/02_Rozpracovane/data
